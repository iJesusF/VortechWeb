# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# WhatsApp (international format without + sign)
NEXT_PUBLIC_WHATSAPP_NUMBER=521234567890

# Admin email for initial setup (used in Supabase Auth)
# ADMIN_EMAIL=admin@example.com

# Max image upload size in bytes (default: 5MB)
NEXT_PUBLIC_MAX_IMAGE_SIZE=5242880
